{
  "expo": {
    "name": "HadirKu",
    "slug": "HadirKu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hadirku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4CFEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oasxyz.HadirKu",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "KOSONGKAN_DULU_TUNGGU_ASPRAK"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E4DAF1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "./plugins/withFirebaseBom.js",
        {
          "bom": "34.19.0"
        }
      ],
      [
        "./plugins/withKotlinGradlePlugin.js",
        {
          "version": "2.2.21"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.21"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "HadirKu memakai kamera untuk memindai QR presensi.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HadirKu memerlukan akses lokasi untuk memastikan Anda berada di dalam radius laboratorium saat melakukan presensi."
        }
      ],
      [
        "expo-notifications",
        "./plugins/withNotificationColorFix"
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce73691c-9db9-44f4-9021-feabfb769622"
      }
    },
    "owner": "ranvierschwann"
  }
}

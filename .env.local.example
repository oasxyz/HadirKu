# Salin berkas ini menjadi .env.local lalu isi key dari asprak. .env.local tidak boleh di-commit.

# Sprint 1-3: layanan AI sentimen/izin (HTTP).
EXPO_PUBLIC_AI_BASE_URL=https://aotianzz.xyz/v1
EXPO_PUBLIC_AI_API_KEY=isi_key_dari_asprak
EXPO_PUBLIC_AI_MODEL=gpt-5.4-mini

# Sprint 4 (SRS4-07..08): konfigurasi Midtrans Snap Sandbox.
# Client Key saja yang dibaca aplikasi mobile. Server Key WAJIB tetap di
# backend-vercel/.env.local untuk testing lokal + dashboard Vercel untuk production.
# Jangan sekali-kali ditaruh di berkas ini.
EXPO_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
EXPO_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# URL dasar backend Vercel (dari `vercel deploy --prod`).
# Format: https://<project-slug>.vercel.app
EXPO_PUBLIC_VERCEL_BASE_URL=https://hadirku-backend.vercel.app
